{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "lumini": {
    "versao": "1.0.0",
    "cor": {
      "noite":   { "$type": "color", "$value": "#08090D", "$description": "Fundo principal (70%)" },
      "carvao":  { "$type": "color", "$value": "#0F1117", "$description": "Superfícies, cards" },
      "grafite": { "$type": "color", "$value": "#171A22", "$description": "Superfícies elevadas" },
      "linha":   { "$type": "color", "$value": "#262A35", "$description": "Bordas e divisórias" },
      "nevoa":   { "$type": "color", "$value": "#8E93A0", "$description": "Texto secundário — 6.5:1 sobre noite" },
      "luz":     { "$type": "color", "$value": "#F2EFE8", "$description": "Texto principal — 17.3:1 sobre noite" },
      "halo":    { "$type": "color", "$value": "#FFE3B0", "$description": "3500 K — realces" },
      "lume":    { "$type": "color", "$value": "#FFB547", "$description": "2700 K — cor da marca" },
      "brasa":   { "$type": "color", "$value": "#FF6A2B", "$description": "1900 K — acento quente" },
      "cobre":   { "$type": "color", "$value": "#B4460F", "$description": "Acento em fundo claro — 4.8:1" },
      "pedra":   { "$type": "color", "$value": "#5B5F6B", "$description": "Texto secundário em fundo claro — 5.5:1" },
      "sucesso": { "$type": "color", "$value": "#5BD69A" },
      "erro":    { "$type": "color", "$value": "#FF5D5D" }
    },
    "fonte": {
      "display": { "$type": "fontFamily", "$value": ["Funnel Display", "Funnel Sans", "sans-serif"] },
      "texto":   { "$type": "fontFamily", "$value": ["Funnel Sans", "system-ui", "sans-serif"] },
      "acento":  { "$type": "fontFamily", "$value": ["Instrument Serif", "Georgia", "serif"], "$description": "Somente itálico, 1–2 palavras por título" },
      "mono":    { "$type": "fontFamily", "$value": ["Martian Mono", "ui-monospace", "monospace"] }
    },
    "tamanho": {
      "mega":  { "$type": "dimension", "$value": "clamp(4rem, 2.2rem + 9.6vw, 13rem)" },
      "d1":    { "$type": "dimension", "$value": "clamp(3rem, 1.9rem + 5.6vw, 7.5rem)" },
      "d2":    { "$type": "dimension", "$value": "clamp(2.25rem, 1.6rem + 3.2vw, 4.5rem)" },
      "h1":    { "$type": "dimension", "$value": "clamp(1.875rem, 1.5rem + 1.8vw, 3rem)" },
      "h2":    { "$type": "dimension", "$value": "clamp(1.5rem, 1.3rem + 1vw, 2.125rem)" },
      "h3":    { "$type": "dimension", "$value": "1.375rem" },
      "lead":  { "$type": "dimension", "$value": "clamp(1.125rem, 1.05rem + .35vw, 1.375rem)" },
      "body":  { "$type": "dimension", "$value": "1rem" },
      "small": { "$type": "dimension", "$value": "0.875rem" },
      "label": { "$type": "dimension", "$value": "0.6875rem" }
    },
    "espaco": {
      "1": { "$type": "dimension", "$value": "4px" },  "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" }, "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "24px" }, "6": { "$type": "dimension", "$value": "32px" },
      "7": { "$type": "dimension", "$value": "48px" }, "8": { "$type": "dimension", "$value": "64px" },
      "9": { "$type": "dimension", "$value": "96px" }, "10": { "$type": "dimension", "$value": "128px" },
      "11": { "$type": "dimension", "$value": "192px" }
    },
    "raio": {
      "0": { "$type": "dimension", "$value": "0" },
      "1": { "$type": "dimension", "$value": "6px" },
      "2": { "$type": "dimension", "$value": "14px" },
      "pill": { "$type": "dimension", "$value": "999px" }
    },
    "movimento": {
      "ease": {
        "lume":    { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1],    "$description": "Entradas" },
        "eclipse": { "$type": "cubicBezier", "$value": [0.76, 0, 0.24, 1],   "$description": "Transições e cortinas" },
        "faisca":  { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1],"$description": "Micro-interações" },
        "brisa":   { "$type": "cubicBezier", "$value": [0.45, 0, 0.55, 1],   "$description": "Loops e respiração" }
      },
      "duracao": {
        "instante": { "$type": "duration", "$value": "120ms" },
        "rapido":   { "$type": "duration", "$value": "240ms" },
        "base":     { "$type": "duration", "$value": "480ms" },
        "lento":    { "$type": "duration", "$value": "900ms" },
        "cena":     { "$type": "duration", "$value": "1400ms" },
        "stagger":  { "$type": "duration", "$value": "60ms" }
      }
    }
  }
}
